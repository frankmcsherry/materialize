# Jaro-Winkler similarity, as `strsim::jaro_winkler` computes it, over bytes.
#
# Input `(s1, s2)`, two `text` arguments. Output a `float8`.
#
# Every loop is a fold over one of the strings, so the work is bounded by
# `len(s1) * len(s2)`. corgi lambdas are closed: a loop body sees only its
# state and its element, so values it needs from outside are carried in the
# state or paired with each element by `cap_list`.
#
# Lines starting with `#` are comments for this file, removed before parsing.
let (s1, s2) = input in
let l1 = s1 len in
let l2 = s2 len in
# The match window, `max(l1, l2) / 2 - 1` saturating at zero.
let d = (l1, l2) max shr 1 max 1 sub 1 in
# Number the bytes: `s1` as `(i, c)`, `s2` as `(j, c, matched)`.
let s1x = ((l1 lit 0, s1) foldscan ((i, c) -> (i add_u64 1, (i, c)))).1 in
let s2x = ((l1 lit 0, s2) foldscan ((j, c) -> (j add_u64 1, (j, c, j lit 0)))).1 in
# The greedy match. For each byte of `s1` in order, take the first unmatched
# equal byte of `s2` within the window, and mark it matched. Each step also
# reports whether `s1[i] == s2[i]` and whether `i < 4`, for the prefix bonus.
let matching = ((d, s2x), s1x) foldscan ((acc, x) ->
    let (d, st) = acc in
    let (i, c) = x in
    let jm = ((d, i, c), st) cap_list map (p ->
        let (ctx, e) = p in
        let (d, i, c) = ctx in
        let (j, ch, m) = e in
        let ok = (((ch, c) eq, (m, m lit 0) eq) mul, ((i, (j, d) add) le, (j, (i, d) add) le) mul) mul in
        (ok, j, j lit 1000000000) select) fold_min in
    let st2 = (jm, st) cap_list map (p ->
        let (jm, e) = p in
        let (j, ch, m) = e in
        (j, ch, (m, (j, jm) eq) max)) in
    let same = ((i, c), st) cap_list map (p ->
        let (ic, e) = p in
        let (i, c) = ic in
        let (j, ch, m) = e in
        ((i, j) eq, (c, ch) eq) mul) fold_max in
    ((d, st2), ((jm, jm lit 1000000000) lt, same, (i, i lit 4) lt, c))) in
let s2m = matching.0.1 in
let per1 = matching.1 in
let m = per1 map (o -> o.0) fold_add in
# Transpositions: the matched bytes of each string, read in order, disagree
# at `t2` positions. Rank each matched byte, then compare equal ranks.
let rank2 = ((l1 lit 0, s2m) foldscan ((k, e) ->
    let (j, ch, mm) = e in
    let k2 = (k, mm) add in
    (k2, (ch, mm, k2)))).1 in
let rank1 = ((l1 lit 0, per1) foldscan ((k, o) ->
    let (hit, same, lt4, c) = o in
    let k2 = (k, hit) add in
    (k2, (c, hit, k2)))).1 in
let t2 = (rank2, rank1) cap_list map (p ->
    let (rank2, e) = p in
    let (c, hit, k) = e in
    let mis = ((c, k), rank2) cap_list map (q ->
        let (ck, f) = q in
        let (c, k) = ck in
        let (ch, mm, k2) = f in
        ((mm, (k2, k) eq) mul, (ch, c) ne) mul) fold_max in
    (mis, hit) mul) fold_add in
let t = t2 shr 1 in
# The common prefix, up to four bytes.
let prefix = (((l1 lit 0, l1 lit 1), per1) fold ((acc, o) ->
    let (p, alive) = acc in
    let (hit, same, lt4, c) = o in
    let a2 = ((alive, same) mul, lt4) mul in
    ((p, a2) add, a2))).0 in
let fm = m to_f64 in
let zero = m lit 0 to_f64 in
let one = m lit 1 to_f64 in
let ten = m lit 10 to_f64 in
let jaro = ((((fm, l1 to_f64) div_f64, (fm, l2 to_f64) div_f64) add_f64, ((fm, t to_f64) sub_f64, fm) div_f64) add_f64, m lit 3 to_f64) div_f64 in
let jaro0 = ((m, m lit 0) eq, zero, jaro) select in
let sim = (((l1, l2) add, m lit 0) eq, one, jaro0) select in
# The Winkler bonus applies above 0.7. corgi has no float literals.
let boost = ((m lit 7 to_f64, ten) div_f64, sim) lt in
let jw = (sim, (((one, ten) div_f64, prefix to_f64) mul_f64, (one, sim) sub_f64) mul_f64) add_f64 in
(boost, jw, sim) select
